# SliTaz package receipt v2.

PACKAGE="ephoto"
SPLIT="ephoto-lang"
VERSION="1.6.0"
CATEGORY="graphics"
SHORT_DESC="A comprehensive image viewer using EFL."
MAINTAINER="robursw@gmail.com"
LICENSE="BSD"
WEB_SITE="https://www.enlightenment.org/about-ephoto"

TARBALL="$PACKAGE-$VERSION.tar.xz"
TARBALL_SHA256="36bc73f3ce1bf9c606630d0031d1629a115911e78b796fd1f90322b5886670d3"
WGET_URL="https://download.enlightenment.org/rel/apps/$PACKAGE/$TARBALL"

BUILD_DEPENDS="autoconf gettext automake libtool shared-mime-info meson ninja \
	jpeg-dev openssl-dev lua5.1-dev freetype-dev fontconfig-dev libxml2-dev \
	fribidi-dev dbus-dev util-linux-mount-dev eudev-dev libsndfile-dev \
	pulseaudio-dev xorg-libX11-dev xorg-libXcomposite xorg-libXcursor \
	xorg-libXdamage xorg-libXext xorg-libXfixes xorg-libXi xorg-libXinerama \
	xorg-libXrandr xorg-libXrender xorg-libXss xorg-libXtst efl-dev"

# Rules to configure and make the package.
compile_rules()
{
	sed -i '/^efl_version = /s/1.26.0/1.25.1/' meson.build
	meson setup --prefix=/usr build . &&
	ninja -C build &&
	DESTDIR=$DESTDIR ninja -C build install
}

# Rules to gen a SliTaz package suitable for Tazpkg.
genpkg_rules()
{
	case $PACKAGE in
		ephoto)
			copy @std 
			cook_copy_icons 128
			DEPENDS="efl"
			;;
		ephoto-lang)
			copy *.mo
			DEPENDS="ephoto"
			;;
	esac
}
